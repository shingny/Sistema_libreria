# ------------------------------------------------------------
#  BASE DE DATOS MySQL (Alwaysdata)
# ------------------------------------------------------------
DB_HOST=mysql-TUCUENTA.alwaysdata.net
DB_PORT=3306
DB_NAME=TUCUENTA_libreria
DB_USER=TUCUENTA_libreria
DB_PASSWORD=ESCRIBE_AQUI_TU_CONTRASENA
DB_CHARSET=utf8mb4

# ------------------------------------------------------------
#  SITIO (opcional)
